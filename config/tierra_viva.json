    {
      "key": "token.unpaid_share_with_libreta",
      "value": "10% base, 15% conservative, 8% optimistic",
      "status": "pitch deck",
      "why": "Case: 25% of credit is never repaid (Exhibit A). The written, read-back Libreta plus the on-time reward is assumed to cut that to 10%."
    },
    {
      "key": "token.on_time_share_of_repaid",
      "value": 0.5,
      "status": "assumption (reproduces the deck)",
      "why": "Half of repaid credit is repaid in cash within 30 days and earns the 5% reward: 594 x 90% x 50% x 5% = 13 tokens."
    },
    {
      "key": "token.on_time_cash_reward_share",
      "value": 0.05,
      "status": "pitch deck",
      "why": "5% reward in tokens for cash repaid within 30 days."
    },
    {
      "key": "token.earn.pickup",
      "value": "12 rides x $10, half in tokens",
      "status": "pitch deck",
      "why": "A neighbor's pickup at peak harvest replaces the $240 a year of pickup rides (case cash costs); half the $10 fare is paid in tokens = 60 tokens a year. A transport fare, not labor."
    },
    {
      "key": "token.cost_share_of_face",
      "value": "75% base, 90% conservative, 60% optimistic",
      "status": "pitch deck",
      "why": "What a redeemed $1 token costs Ernestine in produce she would otherwise sell."
    },
    {
      "key": "token.cap_share_of_sales",
      "value": 0.1,
      "status": "pitch deck",
      "why": "Tokens issued in a year are capped at 10% of sales ($137 in a normal year)."
    },
    {
      "key": "token.drum2_capture_of_turned_away",
      "value": 0.7,
      "status": "pitch deck",
      "why": "Drum 2 lets her serve 70% of the pre-harvest buyers she now turns away."
    },
    {
      "key": "token.turned_away_per_week_used",
      "value": 9,
      "status": "case-derived",
      "why": "Midpoint of 8-10 buyers a week for 13 weeks at $1.50 (Exhibit D): $176."
    },
    {
      "key": "token.drums",
      "value": "2 drums: drum 1 family, drum 2 sale",
      "status": "case-derived",
      "why": "Exhibit E: $100 each, ~250 lb each. Drum 1 is the family's food, never sold, never backs tokens."
    },
    {
      "key": "token.drum2_fill_lb",
      "value": "50 lb corn + 200 lb beans",
      "status": "assumption",
      "why": "Beans carry 3.3x the value of corn per lb, so a mostly-bean drum 2 ($215) can back every token and still serve $123 of pre-harvest sales within 250 lb."
    },
    {
      "key": "token.crop_repayment_lb",
